{
  "mcpServers": {
    "envcore_gateway": {
      "type": "http",
      "url": "http://envcore.int-worker.emergentagent.com/api/v1/env/gateway"
    },
    "user_analysis": {
      "type": "http",
      "url": "http://agent-service.cloudrun.internal.prod.emergentagent.com/user-analysis/mcp/"
    },
    "deployer": {
      "type": "http",
      "url": "http://deployer-mcp.internal-apps.emergentagent.com/mcp"
    },
    "support": {
      "type": "http",
      "url": "http://support-mcp.internal-apps.emergentagent.com"
    },
    "cortex_debugger": {
      "type": "http",
      "url": "http://cortex-debugger.int.apis.emergentagent.com"
    },
    "redash": {
      "command": "uvx",
      "args": ["redash-mcp"],
      "env": {
        "REDASH_URL": "http://redash.internal-apps.emergentagent.com",
        "REDASH_API_KEY": "${REDASH_API_KEY}"
      }
    }
  }
}
